---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Experience from '../components/Experience.astro';
import PostList from '../components/PostList.astro';
import { profile, experience } from '../data/profile';
import projects from '../data/projects.json';
import { url, type Project } from '../lib/url';

const featured = (projects as Project[]).slice(0, 4);
---

<Base>
  <h1>{profile.name}</h1>
  <p class="lede">{profile.bio}</p>
  <div class="links">
    {profile.links.map((l) => <a href={l.href} rel="me noopener">{l.label} ↗</a>)}
    <a href={url('/resume/')}>resume</a>
  </div>

  <h2 class="section">Experience</h2>
  <Experience jobs={experience} />
  <a class="more" href={url('/resume/')}>full resume →</a>

  <h2 class="section">Projects</h2>
  <div class="grid">
    {featured.map((p) => <ProjectCard project={p} />)}
  </div>
  <a class="more" href={url('/projects/')}>all projects →</a>

  <h2 class="section">Writing</h2>
  <PostList limit={5} />
</Base>
