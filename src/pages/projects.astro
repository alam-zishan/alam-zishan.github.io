---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import type { Project } from '../lib/url';

const order = { live: 0, wip: 1, done: 2, paused: 3 } as const;
const list = [...(projects as Project[])].sort((a, b) => order[a.status] - order[b.status]);
---

<Base title="Projects">
  <h1>Projects</h1>
  <p class="lede">Things I build outside work. Cards marked <span class="pill live">live</span> update on their own.</p>
  <h2 class="section">All</h2>
  <div class="grid">
    {list.map((p) => <ProjectCard project={p} full />)}
  </div>
</Base>
